# serializer version: 1
# name: test_assert_snapshot_queries
  dict({
    'num_queries': 1,
    'queries': list([
      dict({
        'origin': list([
          'QuerySet.count[<site-packages>/django/db/models/query.py]',
        ]),
        'sql': '''
          SELECT COUNT(*) AS "__count"
          FROM "auth_user"
        ''',
      }),
    ]),
  })
